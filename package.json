{
  "name": "@yourscope/my-deck-widgets",
  "version": "0.1.0",
  "description": "Custom deck.gl layers for pydeck custom_libraries, served over jsDelivr from npm.",
  "license": "MIT",
  "main": "dist/bundle.js",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "webpack",
    "watch": "webpack --watch",
    "serve": "http-server -p 8080 --cors -c-1 .",
    "dev": "concurrently -k -n build,serve \"npm:watch\" \"npm:serve\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
  "concurrently": "^10.0.4",
  "http-server": "^14.1.1",
  "webpack": "^5.109.2",
  "webpack-cli": "^7.2.2"
}
}
